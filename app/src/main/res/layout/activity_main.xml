<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando estado…"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Permitir cámara" />

        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Calibrar mirada: 9 puntos" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3. Activar EyeControl en Accesibilidad" />

        <CheckBox
            android:id="@+id/blinkEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clic por cierre deliberado (experimental, 0,5–1,5 s)" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tiempo de mirada fija para hacer clic" />
        <Spinner android:id="@+id/dwellTime" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/dwell_options" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="14sp"
            android:text="Calibra los 9 puntos con el teléfono firme y la cabeza quieta. Mueve los ojos para seguir los puntos.\n\nEl panel derecho permite toque, doble toque, pulsación larga, deslizar y pausa. Para deslizar, fija la mirada en el inicio y después en el destino.\n\nBordes: arriba = Atrás; abajo = Inicio; laterales = desplazar.\n\nEl cierre deliberado es opcional. Los guiños y parpadeos breves no hacen clic. Desactívalo si produce acciones involuntarias.\n\nPara detener: Ajustes → Accesibilidad → Aplicaciones instaladas → EyeControl. Procesamiento local de cámara." />
    </LinearLayout>
</ScrollView>
